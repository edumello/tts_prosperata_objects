          rectAlignment="UpperLeft" offsetXY="1000 -45"
          alignment="MiddleRight" color="#B79B3D" fontSize="27"
          fontStyle="BoldAndItalic" />
    <Panel class="line" width="1732" height="2"
           rectAlignment="UpperLeft" offsetXY="30 -132" />

    <!-- Divisores e titulos das tres colunas -->
