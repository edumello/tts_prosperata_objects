<!-- Object UI do painel Edward. Este arquivo e a fonte canonica do XML
     incorporado em ataque_edward.lua pelo script de build. -->
<Defaults>
    <Text color="#D6D3CC" fontSize="22" fontStyle="Bold"
          alignment="MiddleCenter" resizeTextForBestFit="true"
          resizeTextMinSize="13" resizeTextMaxSize="26"
          horizontalOverflow="Wrap" verticalOverflow="Truncate" />

    <Panel class="line" color="#8F7425" raycastTarget="false" />
    <Panel class="section" color="#0D0E0FF4" raycastTarget="false" />
    <Panel class="statePill" color="#292C30" outline="#555A60"
           outlineSize="2 2" raycastTarget="false" />
    <Panel class="previewCard" color="#0B2518F6" outline="#1E6D43"
           outlineSize="2 2" raycastTarget="false" />

    <Button class="headerButton" fontSize="17" fontStyle="Bold"
            textColor="#E4C75E" textAlignment="MiddleCenter"
            resizeTextForBestFit="true" resizeTextMinSize="13"
            resizeTextMaxSize="19"
            colors="#201D13|#3A3218|#15130E|#12110ECC"
            outline="#8F7425" outlineSize="2 2" padding="8 8 4 4" />
    <Button class="rowButton" fontSize="23" fontStyle="Bold"
            textColor="#E0E1E3" textAlignment="MiddleLeft"
            resizeTextForBestFit="true" resizeTextMinSize="16"
            resizeTextMaxSize="24"
            colors="#181A1C|#26292C|#111315|#111315CC"
            outline="#34383D" outlineSize="2 2" padding="24 125 5 5" />
    <Button class="modeButton" fontSize="20" fontStyle="Bold"
            textColor="#E7C84A" textAlignment="MiddleLeft"
            resizeTextForBestFit="true" resizeTextMinSize="14"
            resizeTextMaxSize="21"
            colors="#201C0D|#393015|#151208|#121008CC"
            outline="#8F7425" outlineSize="2 2" padding="22 12 5 5" />
    <Button class="miniButton" fontSize="26" fontStyle="Bold"
            textColor="#F0F0F2" textAlignment="MiddleCenter"
            resizeTextForBestFit="true" resizeTextMinSize="17"
            resizeTextMaxSize="27"
            colors="#2A2D31|#44484D|#191B1E|#17191BCC"
            outline="#60656B" outlineSize="2 2" padding="2 2 2 2" />

    <Button class="blueAction" fontSize="31" fontStyle="Bold"
            textColor="#8BB9DF" textAlignment="MiddleCenter"
            resizeTextForBestFit="true" resizeTextMinSize="18"
            resizeTextMaxSize="33"
            colors="#163B5E|#245882|#0F2942|#0C2136CC"
            outline="#3E79A4" outlineSize="3 3" padding="16 16 12 12" />
    <Button class="orangeAction" fontSize="31" fontStyle="Bold"
            textColor="#D8A34F" textAlignment="MiddleCenter"
            resizeTextForBestFit="true" resizeTextMinSize="18"
            resizeTextMaxSize="33"
            colors="#4D2705|#72410D|#331A04|#2C1603CC"
            outline="#986018" outlineSize="3 3" padding="16 16 12 12" />
    <Button class="redAction" fontSize="31" fontStyle="Bold"
            textColor="#D98380" textAlignment="MiddleCenter"
            resizeTextForBestFit="true" resizeTextMinSize="18"
            resizeTextMaxSize="33"
            colors="#521010|#74201F|#350A0A|#2E0909CC"
            outline="#8B302E" outlineSize="3 3" padding="16 16 12 12" />
    <Button class="clearAction" fontSize="29" fontStyle="Bold"
            textColor="#AAA8BF" textAlignment="MiddleCenter"
            resizeTextForBestFit="true" resizeTextMinSize="17"
            resizeTextMaxSize="31"
            colors="#171723|#29293A|#101018|#0E0E16CC"
            outline="#47475E" outlineSize="3 3" padding="16 16 12 12" />

    <InputField class="nameInput" fontSize="21" fontStyle="Bold"
                textColor="#C8C9CC" color="#1A1C1E"
                colors="#1A1C1E|#292C30|#111315|#101214CC"
                alignment="MiddleLeft" lineType="SingleLine"
                characterValidation="None" characterLimit="18"
                caretColor="#E4C75E" selectionColor="#776624AA"
                outline="#34383D" outlineSize="2 2" padding="18 10 4 4" />
</Defaults>

<!-- Proporcao 7:4, proxima ao painel de referencia. A textura contem apenas
     a moldura; toda a grade abaixo usa um unico sistema de coordenadas. -->
